NODE_ENV=development
POSTGRES_DB=regcontrol
POSTGRES_USER=regcontrol
POSTGRES_PASSWORD=regcontrol
DATABASE_URL=postgresql://regcontrol:regcontrol@postgres:5432/regcontrol
API_PORT=3000
API_HOST=0.0.0.0
BOT_PORT=3001
BOT_HOST=0.0.0.0
VITE_API_URL=http://localhost:3000

# MAX. Keep secrets server-side only.
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=https://example.ru/webhook
MAX_MINI_APP_URL=https://example.ru/
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
SESSION_SECRET=change-this-to-a-long-random-secret
SESSION_TTL_SECONDS=604800
ALLOW_DEV_AUTH=true

# LLM draft extraction. mock is the safe offline default.
LLM_PROVIDER=mock
LLM_MODEL=GigaChat-2-Pro
LLM_TIMEOUT_MS=45000
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# If Node reports a GigaChat certificate error, place the official CA bundle in ./certs and set:
# NODE_EXTRA_CA_CERTS=/app/certs/gigachat-ca.pem
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Official-source ingestion staging. Each source is independent: a blocked source does not stop the rest.
PRAVO_OPEN_DATA_URL=https://publication.pravo.gov.ru/OpenData/7710349494-legalacts-90
GOVERNMENT_DOCS_URL=https://government.ru/docs/all/
FNS_CHANGES_URL=https://www.nalog.gov.ru/new2026/
CBR_LEGAL_ACTS_URL=https://www.cbr.ru/na/
CBR_DIGITAL_RUBLE_URL=https://www.cbr.ru/PSystem/dr/dr_for_business/accepting_payments_dr/
ROSPOTREBNADZOR_NEWS_URL=https://zpp.rospotrebnadzor.ru/news/federal/
INGESTION_ENABLE_PRAVO=true
INGESTION_ENABLE_GOVERNMENT=true
INGESTION_ENABLE_FNS=true
INGESTION_ENABLE_CBR=true
INGESTION_ENABLE_ROSPOTREBNADZOR=true
INGESTION_USER_AGENT=max-regulatory-control-hackathon/0.9
INGESTION_TIMEOUT_MS=20000
INGESTION_RETRIES=2
ADMIN_TOKEN=change-admin-token
NOTIFICATION_POLL_SECONDS=60
